{
  "schemaVersion": 1,
  "id": "soullink",
  "version": "${version}",
  "name": "Soul Link",
  "description": "Cooperative Soul Link speedruns on dedicated servers and integrated single-player/LAN worlds.",
  "authors": ["Soul Link Contributors"],
  "license": "Apache-2.0",
  "contact": {
    "sources": "https://github.com/qwasdf-1/soul-link",
    "issues": "https://github.com/qwasdf-1/soul-link/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.soullink.SoulLinkInitializer"]
  },
  "mixins": ["${mixins_config}"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "terrarasa": ">=${terra_rasa_version}"
  }
}
